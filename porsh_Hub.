-- 1. ระบบ Auto Skip Wave เฉพาะแมพ Cameraman TD
local ToggleSkip = Tabs.CameramanTD:AddToggle("CameramanSkip", {Title = "Auto Skip Wave (ข้ามเวฟทันที)", Default = false })
ToggleSkip:OnChanged(function(Value)
    _G.CameramanAutoSkip = Value
    playSwordSound(Value)
    task.spawn(function()
        while _G.CameramanAutoSkip do
            task.wait(0.5)
            pcall(function()
                game:GetService("ReplicatedStorage").Net:GetService("RemoteEvent"):FireServer("SkipWave")
            end)
        end
    end)
end)

-- 2. ระบบ Auto Upgrade ยูนิตของเราเอง
local ToggleUpgrade = Tabs.CameramanTD:AddToggle("CameramanUpgrade", {Title = "Auto Upgrade (อัปเกรดยูนิตทั้งหมด)", Default = false })
ToggleUpgrade:OnChanged(function(Value)
    _G.CameramanAutoUpgrade = Value
    playSwordSound(Value)
    task.spawn(function()
        while _G.CameramanAutoUpgrade do
            task.wait(1)
            pcall(function()
                local localPlayer = game:GetService("Players").LocalPlayer
                if game:GetService("Workspace"):FindFirstChild("Towers") then
                    for _, unit in pairs(game:GetService("Workspace").Towers:GetChildren()) do
                        if unit:FindFirstChild("Owner") and unit.Owner.Value == localPlayer.Name then
                            game:GetService("ReplicatedStorage").Net:GetService("RemoteEvent"):FireServer("UpgradeTower", unit)
                        end
                    end
                end
            end)
        end
    end)
end)

