local function playSwordSound(isOn)
    local sound = Instance.new("Sound")
    if isOn then
        sound.SoundId = "rbxassetid://9114223403" -- เสียงดาบปะทะกันเมื่อเปิด
        sound.Pitch = 1.1
        sound.Volume = 0.6
    else
        sound.SoundId = "rbxassetid://9114223403" -- เสียงดาบฟันเฉือนเมื่อปิด
        sound.Pitch = 0.8
        sound.Volume = 0.4
    end
    sound.Parent = game:GetService("SoundService")
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

